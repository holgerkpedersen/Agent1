# ============================================================
# 🤖 Agent Framework Configuration (.env)
# Copy this file to `.env` and adjust values for your environment.
# Pydantic will automatically map these uppercase vars to the 
# snake_case fields in config.py.
# ============================================================

# LLM Configuration
MODEL_NAME=gpt-4o
API_KEY=your-api-key-here

# Workspace & Filesystem (Must be an absolute path)
WORKSPACE_ROOT=/path/to/agent/workspace

# HTTP Timeouts (seconds)
HTTP_TIMEOUT_CONNECT=5.0
HTTP_TIMEOUT_READ=30.0

# Index & Search Configuration
MAX_INDEX_SIZE=5000
CHUNK_OVERLAY_BYTES=512

# NLP Output Verbosity (verbose|clean|quiet) — controls how tool calls and
# results are printed during natural-language turns. verbose: every call + result;
# clean: a reason line per call with summarized results; quiet: only final answer.
AGENT_DISPLAY_MODE=verbose

# ============================================================
# Full pytest run time budget (conftest.py watchdog)
# ============================================================
# A bare `pytest` (full run, no explicit test paths) records its elapsed time
# into .env as PYTEST_LAST_FULL_RUN_SECONDS, and the NEXT full run enforces a
# ceiling of max(PYTEST_FULL_SUITE_TIMEOUT, last duration * 1.20).  Targeted
# runs (pytest tests/test_x.py) are never measured or killed.
# PYTEST_FULL_SUITE_TIMEOUT=600
# PYTEST_LAST_FULL_RUN_SECONDS=

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================
# 🤖 LLM Provider — opencode (opencode-go models)
# ============================================================
# Provider selection (lmstudio|opencode) - a model prefix ("opencode-go/...")
# overrides this regardless of the setting.
AGENT_LLM_PROVIDER=opencode

# Ordered LLM failover chain (decision #013).  Comma-separated list of
# providers to try in order when the active one loses connectivity.  Defaults
# to the cloud-first / local-fallback chain below when unset, so single-
# provider setups can still pin a single entry.  Each entry may carry a
# per-entry model override ("provider:model") so the same provider appears
# twice in different modes (zen free tier vs go keyed tier).  Order is:
# 1) opencode-zen FREE tier (primary cloud), 2) opencode-go (secondary cloud),
# 3) LM Studio (primary local), 4) llama.cpp (secondary local).  The first
# entry MUST match AGENT_LLM_PROVIDER.
# AGENT_LLM_PROVIDERS=opencode:opencode-zen/hy3-free,opencode:opencode-go/deepseek-v4-flash,lmstudio,llama

# Default opencode-go model (persisted model choice in model.json wins).
AGENT_OPENCODE_MODEL=opencode-go/deepseek-v4-flash

# opencode-zen FREE tier (keyless) — default free model for catalog listing
# and ordered fallback list for when the active free model is unavailable.
AGENT_ZEN_FREE_DEFAULT=opencode-zen/hy3-free
AGENT_ZEN_FREE_FALLBACKS=opencode-zen/hy3-free,opencode-zen/laguna-s-2.1-free,opencode-zen/mimo-v2.5-free

# --- Direct hosted API mode (PREFERRED) ---
# When OPENCODE_API_KEY is set, the provider calls the hosted opencode-go
# gateway (OpenAI-compatible, NATIVE tool calling) instead of a local server.
# If this var is left empty, the provider also checks opencode's own
# credentials store (~/.local/share/opencode/auth.json, "opencode-go" entry),
# so the key is picked up automatically even without .env.
OPENCODE_API_KEY=sk-your-opencode-go-key-here

# Hosted endpoint (default is correct — only override if you use a proxy).
OPENCODE_API_URL=https://opencode.ai/zen/go/v1

# API request timeout in seconds (default 600 — workflow plan steps can be
# slow reads; lower it if you want faster failures).
# OPENCODE_TIMEOUT=600

# ============================================================
# 🤖 LLM Provider — openrouter (hosted multi-model gateway)
# ============================================================
# When AGENT_LLM_PROVIDER=openrouter (or a model is prefixed openrouter/),
# the agent talks to OpenRouter over the standard OpenAI-compatible
# /chat/completions protocol with NATIVE tool calling.  Model ids are
# namespaced openrouter/<vendor>/<model>, e.g.
# openrouter/anthropic/claude-3.5-haiku (free variants carry a :free suffix).
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Hosted endpoint (default is correct — only override if you use a proxy).
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# Default openrouter model (persisted model choice in model.json wins).
# AGENT_OPENROUTER_MODEL=openrouter/deepseek/deepseek-chat-v3-0324

# API request timeout in seconds (default 600 — workflow plan steps can be
# slow reads; lower it if you want faster failures).
# OPENROUTER_TIMEOUT=600

# ============================================================
# Autonomous self-improvement (HarnessFix loop)
# ============================================================
# Trace capture is ON by default (one JSONL trace per tool-loop run under
# reports/traces/).  Set to 1 to disable (opt-out, decision #029/#050).
# AGENT_NO_TRACE=0
# Fully autonomous self-improvement driver (scripts/autonomous_self_improve.py)
# requires this flag (or --auto) to engage — never flips on by accident.
# Set to 1 to allow the driver to apply + commit gated repairs.
# AGENT_AUTONOMOUS=0
# Kill-switch: create a file named STOP_AUTONOMOUS in the repo root (or set
# this env var to 1) to halt the autonomous loop cleanly between iterations.
# STOP_AUTONOMOUS=0

# Transient-failure retry (default 3 attempts, exponential backoff). The
# hosted gateway intermittently returns HTTP 5xx on healthy requests; these
# retries prevent a single blip from aborting a whole workflow run.
# OPENCODE_MAX_RETRIES=3
# OPENCODE_RETRY_BASE_DELAY=2.0

# --- Local server mode (fallback) ---
# Only used when no API key is available: talk to a running local server.
# Start it with:  opencode serve --port 4096
OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_PASSWORD=optional-server-password

# --- opencode-zen FREE tier (keyless) ---
# The opencode-zen FREE tier needs no API key.  The agent names free models
# "opencode-zen/<id>-free" (e.g. opencode-zen/hy3-free).  These settings let
# you customize the default free model used for catalog listing and the
# ordered fallback list used when the active free model is temporarily
# unavailable on the backend (models come and go — update this list as needed).
# AGENT_ZEN_FREE_DEFAULT=opencode-zen/hy3-free
# AGENT_ZEN_FREE_FALLBACKS=opencode-zen/hy3-free,opencode-zen/laguna-s-2.1-free,opencode-zen/mimo-v2.5-free

