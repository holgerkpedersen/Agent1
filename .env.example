# ============================================================
# 🤖 Agent Framework Configuration (.env)
# Copy this file to `.env` and adjust values for your environment.
# Pydantic will automatically map these uppercase vars to the 
# snake_case fields in config.py.
# ============================================================

# LLM Configuration
MODEL_NAME=gpt-4o
API_KEY=your-api-key-here

# Workspace & Filesystem (Must be an absolute path)
WORKSPACE_ROOT=/path/to/agent/workspace

# HTTP Timeouts (seconds)
HTTP_TIMEOUT_CONNECT=5.0
HTTP_TIMEOUT_READ=30.0

# Index & Search Configuration
MAX_INDEX_SIZE=5000
CHUNK_OVERLAY_BYTES=512

# NLP Output Verbosity (verbose|clean|quiet) — controls how tool calls and
# results are printed during natural-language turns. verbose: every call + result;
# clean: a reason line per call with summarized results; quiet: only final answer.
AGENT_DISPLAY_MODE=verbose

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================
# 🤖 LLM Provider — opencode (opencode-go models)
# ============================================================
# Provider selection (lmstudio|opencode) - a model prefix ("opencode-go/...")
# overrides this regardless of the setting.
AGENT_LLM_PROVIDER=opencode

# Default opencode-go model (persisted model choice in model.json wins).
AGENT_OPENCODE_MODEL=opencode-go/deepseek-v4-flash

# --- Direct hosted API mode (PREFERRED) ---
# When OPENCODE_API_KEY is set, the provider calls the hosted opencode-go
# gateway (OpenAI-compatible, NATIVE tool calling) instead of a local server.
# If this var is left empty, the provider also checks opencode's own
# credentials store (~/.local/share/opencode/auth.json, "opencode-go" entry),
# so the key is picked up automatically even without .env.
OPENCODE_API_KEY=sk-your-opencode-go-key-here

# Hosted endpoint (default is correct — only override if you use a proxy).
OPENCODE_API_URL=https://opencode.ai/zen/go/v1

# API request timeout in seconds (default 600 — workflow plan steps can be
# slow reads; lower it if you want faster failures).
# OPENCODE_TIMEOUT=600

# Transient-failure retry (default 3 attempts, exponential backoff). The
# hosted gateway intermittently returns HTTP 5xx on healthy requests; these
# retries prevent a single blip from aborting a whole workflow run.
# OPENCODE_MAX_RETRIES=3
# OPENCODE_RETRY_BASE_DELAY=2.0

# --- Local server mode (fallback) ---
# Only used when no API key is available: talk to a running local server.
# Start it with:  opencode serve --port 4096
OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_PASSWORD=optional-server-password

