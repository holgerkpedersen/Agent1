#!/bin/sh
# Pre-commit hook: keep ruff in the implementation loop so CI never breaks on
# lint violations. Mirrors .github/workflows/ci.yml:
#   - BLOCKING:  ruff check --select F821   (parse errors / undefined names)
#   - BLOCKING:  ruff check                  (full E/F/W lint, incl. E501)
#
# The hook auto-fixes what ruff can fix (--fix) on the FILES BEING COMMITTED,
# restages them, then runs a blocking full lint.  It only guards changes you
# are about to ship -- it never touches unrelated working-tree files.
set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

if ! command -v ruff >/dev/null 2>&1; then
  echo "pre-commit: ruff not found on PATH; skipping ruff checks." >&2
  exit 0
fi

# Only the Python files this commit introduces or modifies.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
if [ -z "$STAGED" ]; then
  echo "pre-commit: no Python files staged; skipping ruff checks."
  exit 0
fi

# 1) Auto-fix whatever ruff can fix on the staged files, then re-stage so the
#    fixed content is what gets committed.
echo "pre-commit: ruff check --fix (auto-fix, staged python files)..."
# shellcheck disable=SC2086
ruff check --fix $STAGED >/dev/null 2>&1 || true
git add $STAGED >/dev/null 2>&1 || true

# 2) BLOCKING gate: parse errors + undefined names (F821) must be clean,
#    exactly like CI.  A non-zero exit aborts the commit.
echo "pre-commit: ruff --select F821 (blocking, mirroring CI)..."
# shellcheck disable=SC2086
if ! ruff check --select F821 $STAGED; then
  echo "" >&2
  echo "pre-commit: FAILED — undefined names / parse errors above." >&2
  echo "Fix these before committing (this is the same gate CI blocks on)." >&2
  exit 1
fi

# 3) BLOCKING full lint (E/F/W, incl. E501 line-too-long).  No commit may
#    introduce or leave a ruff violation on a file it touches.
echo "pre-commit: ruff full lint (blocking)..."
# shellcheck disable=SC2086
if ! ruff check $STAGED; then
  echo "" >&2
  echo "pre-commit: FAILED — ruff violations above on files being committed." >&2
  echo "Run 'ruff check --fix' and wrap long lines (E501), then re-commit." >&2
  exit 1
fi

echo "pre-commit: ruff checks passed for staged files."
exit 0
